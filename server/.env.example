PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./data/read-remember.sqlite
# 本地英汉/英英词典；运行 npm run setup:ecdict 自动下载并初始化。
ECDICT_PATH=./data/ecdict.sqlite

# Kokoro 整篇朗读。Base URL 通常包含 /v1，API_PATH 默认接在其后。
KOKORO_BASE_URL=http://127.0.0.1:8880/v1
KOKORO_API_PATH=/audio/speech
KOKORO_API_KEY=
KOKORO_MODEL=kokoro
KOKORO_FORMAT=mp3
KOKORO_AUDIO_ROOT=./data/article-audio
KOKORO_TIMEOUT_MS=300000
KOKORO_MAX_INPUT_CHARACTERS=12000
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_VOICES=af_heart|温和女声 · 美音,am_michael|沉稳男声 · 美音,bf_emma|自然女声 · 英音,bm_george|沉稳男声 · 英音

# 文章批量翻译：支持任意 OpenAI Chat Completions 兼容接口。
TRANSLATION_LLM_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_LLM_API_PATH=/chat/completions
TRANSLATION_LLM_API_KEY=
TRANSLATION_LLM_MODEL=your-translation-model
TRANSLATION_TARGET_LANGUAGE=zh-CN
TRANSLATION_BATCH_SIZE=8
TRANSLATION_CONCURRENCY=2
TRANSLATION_TIMEOUT_MS=120000
TRANSLATION_MAX_RETRIES=3
TRANSLATION_JSON_MODE=false
# 特殊供应商需要额外请求头时填写 JSON，例如 {"X-Project":"read-remember"}。
TRANSLATION_LLM_HEADERS_JSON=
CORS_ORIGIN=*
ADMIN_API_KEY=dev-admin-change-me
# 允许后台通过 HTTPS 同步 JSON 题库的域名，多个域名使用英文逗号分隔。
SYNC_ALLOWED_HOSTS=content.example.com,questions.example.org
# 每天在指定时区的这个小时后，为每位用户自动推荐一篇对应考试类型文章。
DAILY_PUSH_ENABLED=true
DAILY_PUSH_HOUR=8
DAILY_PUSH_TIME_ZONE=Asia/Shanghai

# Expo Web 构建产物目录；默认使用 ../client/dist。
WEB_ROOT=../client/dist
