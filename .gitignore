.DS_Store

# Dependencies and build output
**/node_modules/
**/dist/
**/build/
**/*.apk
**/*.aab
**/*.ipa

# Expo local state
**/.expo/
**/.eas/

# Local environment files (keep examples)
**/.env
**/.env.*
!**/.env.example

# Runtime database files
server/data/*.sqlite
server/data/*.sqlite-shm
server/data/*.sqlite-wal
server/data/*.bak
server/data/*.db
server/data/*.zip
server/data/article-audio/
server/config/translation.json
server/config/story-generation.json

# Logs and coverage
*.log
**/coverage/

