{
  "expo": {
    "name": "拾词 Read & Remember",
    "slug": "read-remember",
    "version": "1.0.0",
    "scheme": "readremember",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.readremember.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E6258"
      },
      "package": "com.readremember.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "拾词 Read & Remember",
      "shortName": "拾词",
      "themeColor": "#1E6258",
      "backgroundColor": "#F5F1E8"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-notifications"
    ]
  }
}
